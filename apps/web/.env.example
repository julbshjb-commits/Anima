# Copier en .env.local et remplir avec les valeurs du projet Supabase (Réglages > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Serveur uniquement : suppression de compte. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Adresse publique du site, pour les liens de connexion envoyés par e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
